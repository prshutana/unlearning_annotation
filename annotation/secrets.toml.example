# Copy to .streamlit/secrets.toml locally, or paste into the app's
# "Secrets" settings on Streamlit Community Cloud. Never commit real secrets.

annotators = ["gabriella", "franzi", "max", "ana"]

[github]
token  = "github_pat_..."          # fine-grained PAT with Contents: read & write on the repo below
repo   = "your-org/annotation-store" # private repo that stores the CSVs
branch = "main"
folder = "annotations"
